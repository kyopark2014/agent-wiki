# Fallback when application/config.json has no llm_gateway_*.
# Primary: ../application/config.json → llm_gateway_url / llm_gateway_key
#
#   cp .env.example .env

TASKS_DB_PATH=../application/data/tasks.db
# CORPUS_DIR=corpus
# GRAPHIFY_OUT_DIR and OUT_DIR both default to out/
# (extract cache + graph.json + graph_{user}.html share one folder).
# GRAPHIFY_OUT_DIR=out
# OUT_DIR=out
# With --user, pipeline uses SESSION_STORAGE_DIR/{user}/graph/out for both
# unless --no-session-storage is set.

# LiteLLM gateway (used only if config.json lacks llm_gateway_*)
LLM_GATEWAY_URL=https://gateway.example.com
LLM_GATEWAY_KEY=sk-...
# Any LiteLLM gateway model id works, e.g.:
#   claude-haiku-4-5, claude-sonnet-4-5, claude-opus-4-5, gpt-5.5, gemini-2.5-pro
GRAPHIFY_LLM_MODEL=claude-haiku-4-5
