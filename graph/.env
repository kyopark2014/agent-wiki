# Paths for the graph pipeline.
# LiteLLM gateway: application/config.json → llm_gateway_url / llm_gateway_key
# If gateway is unset → AWS Bedrock Converse (config.json region + default creds)

TASKS_DB_PATH=../application/data/tasks.db
# CORPUS_DIR=corpus
# GRAPHIFY_OUT_DIR and OUT_DIR both default to out/
# GRAPHIFY_OUT_DIR=out
# OUT_DIR=out
# With --user, pipeline uses SESSION_STORAGE_DIR/{user}/graph/out for both
# unless --no-session-storage is set.

# Graph extract model (gateway id; Bedrock maps claude-haiku-4-5 → us.anthropic…)
GRAPHIFY_LLM_MODEL=claude-haiku-4-5
# Optional Bedrock overrides when gateway is absent:
# GRAPHIFY_BEDROCK_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
# GRAPHIFY_BEDROCK_REGION=us-west-2
